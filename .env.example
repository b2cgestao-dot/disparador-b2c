# ============================================================
# Disparador WhatsApp (API Oficial) - variaveis de ambiente
# Copie para .env  (o ./verify.sh gera/atualiza o .env local sozinho)
# NUNCA commitar o .env com chaves reais.
# ============================================================

PORT=3000

# [PLUG-KEY] URL do Supabase.
#   local:    http://127.0.0.1:54321  (saida de `supabase status`)
#   producao: https://<ref>.supabase.co  (Project Settings -> API -> Project URL)
SUPABASE_URL=http://127.0.0.1:54321

# [PLUG-KEY] service_role (SECRETA, so no backend). Local: `supabase status`.
#   producao: Project Settings -> API -> service_role
SUPABASE_SERVICE_KEY=

# [PLUG-KEY] anon key (publica). O backend injeta URL + anon no index.html ao servir
# (se definida); se o front for servido por outro servidor (Caddy), cole no topo do web/index.html.
SUPABASE_ANON_KEY=

# URL do Supabase vista de DENTRO dos containers docker (local). Em producao e
# igual a SUPABASE_URL.
SUPABASE_URL_DOCKER=http://host.docker.internal:54321

# [PLUG-KEY] Base da Graph API da Meta.
#   local/teste: http://mock-meta:4000   (mock-meta, sem credenciais)
#   producao:    https://graph.facebook.com
META_BASE_URL=http://mock-meta:4000
META_API_VERSION=v21.0

# Usuario seed de teste (SOMENTE local; em producao crie usuarios no painel Auth)
SEED_USER_EMAIL=teste@disparador.local
SEED_USER_PASSWORD=Teste123!
